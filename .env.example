# =============================================================================
#  PLANTILLA .env del BACKEND. Cópiala como .env y completa los valores vacíos.
#  Este archivo SÍ se sube a GitHub: no pongas valores reales aquí.
#
#  .env del BACKEND: un solo archivo para LOCAL y PRODUCCIÓN.
#
#  Cada variable indica qué valor usar:
#    [LOCAL]        trabajando en tu PC (npm run dev, o Docker con https://localhost)
#    [PRODUCCIÓN]   en el servidor (Azure)
#    [AMBOS]        el mismo valor en los dos casos: NO lo cambies al desplegar
#
#  Al desplegar: copia este archivo al servidor y cambia SOLO las variables que
#  tienen un valor distinto en [PRODUCCIÓN] (DOMAIN, NODE_ENV,
#  SECURE_DIAGNOSTICS_ENABLED y opcionalmente LATEX_TIMEOUT_MS).
#
# =============================================================================

# ----------------------------- Servidor --------------------------------------

# Puerto interno del backend.
# [AMBOS] 5000
PORT=5000

# Modo de ejecución.
# [LOCAL] development   [PRODUCCIÓN] production
# (Con Docker siempre se usa production, sin importar este valor.)
NODE_ENV=development

# Llave para firmar tokens.
# [AMBOS] el mismo valor
JWT_SECRET=

# Orígenes que pueden llamar a la API (CORS), separados por comas.
# Solo se usa con npm run dev. Con Docker (local o producción) se ignora: docker-compose usa
# automáticamente https://DOMAIN, así que NO hace falta cambiarla al desplegar.
# [LOCAL] http://localhost:5173,https://*.devtunnels.ms
CORS_ORIGIN=http://localhost:5173

# ------------------- Despliegue con Docker (Caddy) ----------------------------

# Dominio donde se publica la app, sin https://. Solo lo usa Docker (docker compose up).
# [LOCAL]       localhost   -> abre https://localhost
# [PRODUCCIÓN]  tu dominio  (ej. secureleaf.eastus.cloudapp.azure.com)
DOMAIN=localhost

# ----------------------------- Supabase --------------------------------------
# [AMBOS] los mismos valores (local y producción usan el mismo proyecto de Supabase)

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Llave secreta: solo en el backend, NUNCA en el frontend
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# Bucket de Supabase Storage donde se guardan los .tex y PDF de cada proyecto
SUPABASE_STORAGE_BUCKET=DocumentosSecureLeaf

# ------------------------------- LaTeX ---------------------------------------

# Motor de compilación.
# [AMBOS] pdflatex   (local: MiKTeX de tu PC; producción: TeX Live dentro de Docker)
LATEX_ENGINE=pdflatex

# Tiempo máximo de una compilación (ms).
# [LOCAL] 30000   [PRODUCCIÓN] 60000 (una VM pequeña compila más lento)
LATEX_TIMEOUT_MS=30000

# --------------------- Cifrado propio (src/security) -------------------------

# Llave maestra AES-256 (64 hex = 32 bytes). Protege la llave de cada proyecto. SOLO en el servidor.
# [AMBOS] el MISMO valor. Si la cambias, los datos ya cifrados en la base no se podrán leer.
# Para generar una nueva: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_MASTER_KEY=

# Grupo Diffie-Hellman (RFC 3526, 2048 bits). Debe ser igual a VITE_DH_PRIME_HEX / VITE_DH_GENERATOR del frontend.
# [AMBOS] el mismo valor
DH_PRIME_
DH_GENERATOR=2

# Duración de la llave temporal del canal ChaCha20 (ms).
# [AMBOS] 3600000 (1 hora)
SECURE_SESSION_TTL_MS=3600000

# Habilita POST /api/secure/diagnostics/roundtrip (herramienta de pruebas).
# [LOCAL] true   [PRODUCCIÓN] false  (no exponerla en internet)
SECURE_DIAGNOSTICS_ENABLED=false

# true: la API solo acepta peticiones por el túnel cifrado ChaCha20 (excepto el acuerdo de llave y /api/health).
# [AMBOS] true
SECURE_TRANSPORT_REQUIRED=true

# Tamaño máximo de una petición cifrada en bytes.
# [AMBOS] 16777216 (16 MB)
SECURE_TUNNEL_MAX_BYTES=16777216
