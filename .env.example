PORT=
NODE_ENV=
JWT_SECRET=
CORS_ORIGIN=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
# SUPABASE_SECRET_KEY nunca debe ir en el frontend

# Bucket de Supabase Storage donde se guardan los .tex y PDF de cada proyecto
SUPABASE_STORAGE_BUCKET=DocumentosSecureLeaf

# Configuración del compilador LaTeX
LATEX_ENGINE=pdflatex
LATEX_TIMEOUT_MS=30000


# --- Cifrado propio (src/security) ---
# Llave maestra AES-256 (64 hex = 32 bytes). Genérala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRYPTO_MASTER_KEY=
# Grupo Diffie-Hellman (RFC 3526, 2048 bits). Debe ser igual a VITE_DH_PRIME_HEX / VITE_DH_GENERATOR del frontend.
DH_PRIME_
DH_GENERATOR=2
SECURE_SESSION_TTL_MS=3600000
SECURE_DIAGNOSTICS_ENABLED=false
# true: la API solo acepta peticiones por el túnel cifrado ChaCha20 (excepto el acuerdo de llave y /api/health)
SECURE_TRANSPORT_REQUIRED=true
# Tamaño máximo de una petición cifrada en bytes (16 MB)
SECURE_TUNNEL_MAX_BYTES=16777216
